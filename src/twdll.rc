#include <windows.h>

#define VER_FILEVERSION             0,10,0,0
#define VER_FILEVERSION_STR         "0.10.0.0\0"
#define VER_PRODUCTVERSION          0,10,0,0
#define VER_PRODUCTVERSION_STR       "0.10.0.0\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Mateusz Kurowski"
            VALUE "FileDescription",  "Total War Script Extender (twdll)"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "twdll.dll"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Mateusz Kurowski <gitbukowa@gmail.com>"
            VALUE "LegalTrademarks",  "GPL-3.0 | https://github.com/bukowa/twdll"
            VALUE "OriginalFilename", "twdll.dll"
            VALUE "ProductName",      "Total War Script Extender (twdll)"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "Comments",         "https://github.com/bukowa/twdll | Contact: gitbukowa@gmail.com | License: GPL-3.0"
            VALUE "SupportURL",       "https://github.com/bukowa/twdll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
